{
  "_comment": "Single source of MCP servers for Claude Code and Codex. toolbox-mcp-sync writes these into ~/.claude.json and ~/.codex/config.toml at every start; servers you add yourself under other names are left alone. Servers that need cluster credentials run in the mcp-gateway (github.com/kieeps/image-builder, images/mcp-gateway); the ones here work on local files or are hosted. `env` lists variable NAMES; the values come from the cluster (see /etc/profile.d/toolbox-env.sh).",
  "servers": {
    "filesystem": {
      "command": "mcp-server-filesystem",
      "args": [
        "/home/kieeps",
        "/workspace",
        "/host-share",
        "/host-nixos"
      ]
    },
    "kubernetes": {
      "url": "http://mcp-gateway.util.svc.cluster.local:8080/servers/kubernetes/mcp"
    },
    "grafana": {
      "url": "http://mcp-gateway.util.svc.cluster.local:8080/servers/grafana/mcp"
    },
    "homeassistant": {
      "url": "http://mcp-gateway.util.svc.cluster.local:8080/servers/homeassistant/mcp"
    },
    "nextcloud": {
      "url": "http://mcp-gateway.util.svc.cluster.local:8080/servers/nextcloud/mcp"
    },
    "unifi": {
      "url": "http://mcp-gateway.util.svc.cluster.local:8080/servers/unifi/mcp"
    },
    "firefly-iii": {
      "url": "http://mcp-gateway.util.svc.cluster.local:8080/servers/firefly-iii/mcp"
    },
    "jcodemunch": {
      "command": "jcodemunch-mcp"
    },
    "jdocmunch": {
      "command": "jdocmunch-mcp"
    },
    "jdatamunch": {
      "command": "jdatamunch-mcp"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "bearer_env": "GITHUB_PAT_TOKEN"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "paypal": {
      "url": "https://mcp.paypal.com/mcp"
    }
  }
}

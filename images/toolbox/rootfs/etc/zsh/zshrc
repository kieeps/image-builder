# System-wide interactive zsh config for the toolbox.
# Personal additions belong in ~/.zshrc (persistent home), which runs after this.

# Interactive logins land in one shared tmux session. Set TOOLBOX_NO_TMUX=1 to skip.
if [[ -o interactive && -z "${TMUX:-}" && "${TERM:-}" != dumb && -z "${TOOLBOX_NO_TMUX:-}" ]]; then
  # -u: SSH logins often arrive without a UTF-8 LANG; without it tmux falls
  # back to ASCII line drawing and mangles non-ASCII input.
  exec tmux -u new-session -A -s toolbox
fi

export ZSH=/opt/oh-my-zsh
export ZSH_CACHE_DIR="$HOME/.cache/oh-my-zsh"
ZSH_THEME=bira
DISABLE_AUTO_UPDATE=true
plugins=(git z sudo colored-man-pages history-substring-search extract dirhistory kubectl fzf)
source "$ZSH/oh-my-zsh.sh"

HISTFILE="$HOME/.histfile"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE

source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_STRATEGY=(history)
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
